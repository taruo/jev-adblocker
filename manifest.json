{
  "manifest_version": 3,
  "name": "Jev Ad Blocker",
  "version": "0.3.0",
  "minimum_chrome_version": "102",
  "description": "ページ文脈と TypeSafe Jev の意味判定を組み合わせた Chrome 広告ブロッカー。",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Jev Ad Blocker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "static_blocklist",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
